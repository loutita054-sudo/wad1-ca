<form class="ui stacked segment form" action="/dashboard/addskincare" method="POST">
  <div class="two fields">
    <div class="field">
      <label>Category</label>
      <input type="text" name="category" autofocus required title="Please include a valid Category"
        placeholder="Category">
    </div>

    <div class="field">
      <label>Rating (1-5)</label>
      <input type="number" name="rating" min="1" max="5" required title="Please include a rating between 1 and 5"
        placeholder="Rating">
    </div>

  </div>
  <button class="ui blue submit button">Add Product</button>
</form>